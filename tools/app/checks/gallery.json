[
  {"wait": 1000},
  {"key": "v"}, {"wait": 900},
  {"assert": "__app.top.id === 'gallery' && __app.stack.map(s => s.id).join() === 'home,gallery'", "why": "View on Home opens the Media Gallery over Home"},
  {"assert": "__gallery.state().count === 10 && document.querySelector('#screen-gallery .gcount').textContent === 'All: 10'", "why": "every capture is listed, newest first"},
  {"assert": "document.querySelectorAll('#screen-gallery .gcard').length === 10 && document.querySelector('#screen-gallery .gcard.focus .n').textContent === 'Hades'", "why": "thumbnails drawn, the first focused with its game"},
  {"key": "ArrowRight"}, {"key": "ArrowDown"}, {"wait": 450},
  {"assert": "__gallery.state().index === 5", "why": "the grid moves four across"},
  {"assert": "document.querySelector('#screen-gallery .gring').style.transform === 'translate(566px, 568px)'", "why": "the ring sits 6 px around the focused thumbnail"},
  {"key": "ArrowDown"}, {"wait": 450},
  {"assert": "__gallery.state().index === 9 && __gallery.state().scroll === 236", "why": "down to the last row: one short of four, the view scrolls a row"},
  {"key": "Enter"}, {"wait": 500},
  {"assert": "__gallery.state().viewer?.i === 9 && document.querySelector('#screen-gallery .gv').classList.contains('on')", "why": "A shows it full screen"},
  {"assert": "document.querySelector('#screen-gallery .gvcount').textContent === '10 of 10'", "why": "the viewer counts"},
  {"key": "ArrowLeft"}, {"wait": 400},
  {"assert": "__gallery.state().viewer.i === 8 && __gallery.state().index === 8", "why": "Left steps back; the grid follows under it"},
  {"key": "x"}, {"wait": 250},
  {"assert": "__gallery.state().dialog && document.querySelector('#screen-gallery .gdlg .pill.focus').textContent === 'Cancel'", "why": "X asks first, Cancel focused"},
  {"key": "Enter"}, {"wait": 250},
  {"assert": "!__gallery.state().dialog && __gallery.state().count === 10", "why": "Cancel keeps it"},
  {"key": "x"}, {"wait": 250}, {"key": "ArrowLeft"}, {"key": "Enter"}, {"wait": 900},
  {"assert": "(async () => __gallery.state().count === 9 && await __app.host.games.captures().then(c => c.length) === 9)()", "why": "Delete removes it from the host"},
  {"assert": "__gallery.state().viewer?.i === 8", "why": "the viewer stays open on the next one"},
  {"key": "Escape"}, {"wait": 450},
  {"assert": "!__gallery.state().viewer && !document.querySelector('#screen-gallery .gv').classList.contains('on')", "why": "B shrinks it back onto its thumbnail"},
  {"key": "Escape"}, {"wait": 500},
  {"assert": "__app.top.id === 'home'", "why": "B goes back to Home"}
